# Environment — never commit real keys
.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environment
.venv/
venv/
env/

# Runtime state — generated on first run
data/risk_state.json
data/kronos_cache/

# Logs and backtest outputs — large, machine-generated
logs/audit/*
logs/*.csv
logs/*.log
logs/forward_sim.json
!logs/audit/.gitkeep

# Notebook outputs
notebooks/.ipynb_checkpoints/
*.ipynb

# Test / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Vendored third-party source (cloned, not committed)
vendor/

# Claude Code project files
.claude/
