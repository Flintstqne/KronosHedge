# LLM
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here        # optional fallback

# Broker (Alpaca)
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_key_here
ALPACA_PAPER=true                   # set false for live trading

# Alerts — Discord (recommended)
DISCORD_WEBHOOK_URL=                # Server Settings → Integrations → Webhooks → Copy URL

# Alerts — generic webhook (Slack, custom)
ALERT_WEBHOOK_URL=

# Alerts — email (optional)
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=                # Gmail: use an App Password, not your login password
ALERT_EMAIL_TO=

# Macro data — FRED (optional, free at fred.stlouisfed.org/docs/api/api_key.html)
# Enables exact CPI + unemployment data on the News tab FOMC projections
FRED_API_KEY=                       # optional — projections work without it via T-bill yield

# Paths
QLIB_DATA_DIR=~/.qlib/qlib_data/us_data
KRONOS_CACHE_DIR=./data/kronos_cache
AUDIT_LOG_DIR=./logs/audit
